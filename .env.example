# Copie para .env e preencha. Usado pelo docker-compose.
# Chave da API do Groq (ou qualquer provider OpenAI-compatible). Veja https://console.groq.com/
OPENAI_API_KEY=

# Opcionais — o compose ja usa Groq (Llama 3.3 70B) por padrao.
# Descomente para apontar para outro provider OpenAI-compatible (ex.: OpenAI):
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o
# OPENAI_MAX_TOKENS=4096
